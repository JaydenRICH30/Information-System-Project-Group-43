msgstr "有一笔新订单包含了你的商品。"

msgid "Order #%(order_id)s created"
msgstr "订单 #%(order_id)s 已创建"

msgid "Your order is pending and waiting for merchant processing."
msgstr "你的订单已进入待处理状态，正在等待商家处理。"

msgid "Checkout completed. Order #%(order_id)s has been created."
msgstr "结账完成，订单 #%(order_id)s 已创建。"

